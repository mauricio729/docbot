COMPANY_NAME=Loja Exemplo
DOCS_DIR=docs

# Sem OPENAI_API_KEY o bot roda no modo offline (sem custo, por palavras-chave)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=chroma_db
# Relevância mínima para responder (0 a 1). Vazio = padrão do modo
MIN_SCORE=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=docbot-dev
WHATSAPP_APP_SECRET=
# Recebe aviso quando um cliente pede atendente (opcional)
AGENT_PHONE=

ADMIN_TOKEN=troque-esta-chave
DB_PATH=docbot.db
REDIS_URL=
